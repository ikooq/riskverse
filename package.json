{
  "name": "riskverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "vite build --ssr server/start.ts --outDir dist-server",
    "start": "node dist-server/start.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "verify": "npm test && npm run build && node scripts/check-build-secrets.mjs",
    "api": "tsx server/index.ts"
  },
  "dependencies": {
    "lucide-react": "^1.78.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
