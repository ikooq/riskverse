{
  "name": "riskverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": "22.x"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "vite build --ssr server/start.ts --outDir dist-server",
    "start": "node dist-server/start.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "verify": "npm test && npm run build && node scripts/check-build-secrets.mjs",
    "api": "tsx server/index.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
