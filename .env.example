GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional fallback if Gemini is not configured
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Built app + API: npm run build && npm start
HOST=127.0.0.1
PORT=8787
# Set this to the exact https://your-domain.example origin behind your TLS proxy
# PUBLIC_ORIGIN=
# Limits are in memory, for one process; resetting the process resets counters
RISKVERSE_REQUESTS_PER_MINUTE=5
RISKVERSE_DAILY_ANALYSES=100

# Vercel Production requires a shared Redis limiter. Injected by Upstash Marketplace.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Alternatively: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
